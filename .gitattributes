# Normalização de fim de linha: LF no repositório e no checkout, em qualquer SO.
* text=auto eol=lf

# Binários: nunca normalizar nem fazer diff textual.
*.parquet binary
*.png binary
*.pdf binary
*.jpg binary
*.jpeg binary
*.gif binary
*.zip binary
*.npy binary
*.npz binary
*.pkl binary
*.joblib binary
*.ubj binary
*.h5 binary
*.keras binary
*.dbc binary
*.dbf binary
*.nc binary

# Scripts Windows precisam de CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
