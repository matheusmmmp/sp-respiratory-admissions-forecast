# Copie para `.env` (que está no .gitignore e no .dockerignore) e preencha.
# Este arquivo contém SOMENTE placeholders — nunca grave valores reais aqui.

# Copernicus ADS (download do CAMS por src/ingestion/cams_download_chunked.py).
# O script lê estas duas variáveis do ambiente; o caminho via ~/.cdsapirc é
# desaconselhado dentro do projeto. Chave em https://ads.atmosphere.copernicus.eu/profile
CDSAPI_URL=https://ads.atmosphere.copernicus.eu/api
CDSAPI_KEY=<uid>:<api-key>

# MLflow (tracking/ — WP2). Padrão: file store local em ./mlruns.
MLFLOW_TRACKING_URI=./mlruns
